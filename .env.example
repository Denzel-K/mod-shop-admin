# Database Configuration
MONGODB_URI=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random

# Application URL
NEXTAUTH_URL=http://localhost:3000
# For production: https://your-domain.com

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@modshop.com

# Environment
NODE_ENV=development

# CORS for contact form submissions
# Comma-separated list of allowed origins for POST /api/mail/submit
# Example: http://localhost:3000,https://modshop.example.com
ALLOWED_CONTACT_ORIGINS=

## Storage
# The app uses Google Cloud Storage as PRIMARY. If GCP is not configured or temporarily unavailable,
# it will automatically fall back to the local file system under the /public directory.

# Google Cloud (primary storage)
# Service account credentials (JSON fields)
GCP_PROJECT_ID=your-gcp-project-id
GCP_CLIENT_EMAIL=your-service-account@your-gcp-project-id.iam.gserviceaccount.com
# IMPORTANT: Paste the private key exactly as provided by Google, but replace real newlines with \n
GCP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n
# Target bucket for uploads (must exist). If bucket policy does not allow public access,
# files will still upload but public URLs may require authentication.
GCS_BUCKET=your-bucket-name
